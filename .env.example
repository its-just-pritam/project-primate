# Signs session cookies. In backend mode the backend verifies them, so it must use the same value.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=test_auth_secret8924yr34183rdusbv0v0nz09322jr23riksonv1me;m2094345

# Data source. true: the Kotlin backend (primate-backend/) with PostgreSQL. false (default): Google Sheets.
# Read at build time; restart `npm run dev` or rebuild after changing it.
MIGRATE_TO_BACKEND=false

# Backend mode: where the Kotlin backend is listening.
BACKEND_URL=http://localhost:8080

# Sheets mode (and scripts/export-sheets-to-sql.mjs): Google service account with access to the sheet.
# Alternatively place the service account's credentials.json in the project root.
GOOGLE_SERVICE_ACCOUNT_EMAIL="sheets-logger@project-primate-511412.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="1JcGmHgvQA7jQEqryYJu1wINirAc-r9EA0fd5FUa4vIU"
