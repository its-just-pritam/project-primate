{
  "name": "Platito",
  "short_name": "Platito",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#141c2b",
  "theme_color": "#141c2b",
  "description": "Mobile food intake and visual nutrition planner",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.png",
      "sizes": "303x303",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
